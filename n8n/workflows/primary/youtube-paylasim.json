        "jsCode": "const dry = String($env.DRY_RUN || 'true').toLowerCase() === 'true';\nconst auto = String($env.AUTO_PUBLISH || 'false').toLowerCase() === 'true';\nconst allow = (!dry) && (auto || true); // human already approved via Telegram; still block dry_run\nreturn [{ json: { ...$input.first().json, dry_run: dry, auto_publish: auto, allow_upload: !dry } }];"
