      "parameters": {
        "jsCode": "const row=$input.first().json; const title=String(row.baslik||'').trim(); const desc=String(row.aciklama||'').trim(); const maxTitle=40; const issues=[]; if(!title)issues.push('baslik bos'); else if(title.length>maxTitle)issues.push('baslik uzun'); if(!desc||desc.length<20)issues.push('aciklama'); return [{json:{...row,seo_ok:issues.length===0,seo_issues:issues.join('; ')||'ok'}}];"
