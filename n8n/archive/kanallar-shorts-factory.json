        "jsCode": "const data=$input.first().json;\nconst base=$('2. Config').item.json.base_url;\nconst list=(data.shortlist||[]).slice(0,3);\nif(!list.length){\n  return [{json:{has_topics:false, message:'Shortlist boş — katalog/cooldown.', base_url:base}}];\n}\nconst lines=list.map((c,i)=>`#${i+1} ${c.topic}\\nHook: ${c.hook_candidate}\\nAçı: ${c.angle}\\nSkor: ${c.score} trend=${c.trend_signal}\\nidea_id=${c.idea_id}`);\nreturn [{json:{\n  has_topics:true,\n  base_url:base,\n  channel_id:data.channel_id,\n  shortlist:list,\n  telegram_text: '🎯 KONU ONAYI (Gate #1)\\nKanal: '+data.channel_id+'\\nMedya/Kie YOK — önce konu seç.\\n\\n'+lines.join('\\n\\n')\n}}];"
