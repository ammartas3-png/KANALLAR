# Database — PostgreSQL in production. SQLite is test/dev fallback only.
DATABASE_URL=postgresql+psycopg://kanallar:kanallar@127.0.0.1:5432/kanallar

# Studio
KANALLAR_HOST=127.0.0.1
KANALLAR_PORT=8080
ACTIVE_CHANNEL=channel_01

# Renderer: ffmpeg (default, $0) or remotion
RENDERER=ffmpeg

# LLM router (all optional). Empty = local/heuristic, $0.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OLLAMA_BASE_URL=http://127.0.0.1:11434
LLM_CHEAP_MODEL=gpt-4o-mini
LLM_NORMAL_MODEL=gpt-4o-mini
LLM_PREMIUM_MODEL=gpt-4o-mini

# TTS — provider order: gtts, edge, espeak. Paid providers later.
VOICE_PROVIDER=auto
ELEVENLABS_API_KEY=
GOOGLE_TTS_API_KEY=

# YouTube Data API + Analytics (official). Desktop OAuth JSON.
YOUTUBE_CLIENT_SECRETS=./client_secret.json
YOUTUBE_TOKEN=./token.json
YOUTUBE_API_KEY=

# Optional research keys (free tiers). Never required for MVP.
PEXELS_API_KEY=

# --- Human approval (default ON) ---
# true = produce stops at awaiting_approval; upload only after approve
REQUIRE_HUMAN_APPROVAL=true

# --- MediaProvider quality ---
# local = FFmpeg cards ($0, default)
# auto|cheap = prefer Kie when keyed
# premium = prefer Higgsfield when keyed
MEDIA_QUALITY=local

# --- Kie.ai (primary AI media gateway) — https://kie.ai/api-key ---
KIE_API_KEY=
KIE_CALLBACK_URL=
# Pick model ids from https://kie.ai/market — do not guess
KIE_DEFAULT_IMAGE_MODEL=
KIE_DEFAULT_VIDEO_MODEL=
KIE_DEFAULT_VOICE_MODEL=

# --- Higgsfield (secondary/premium) — Cloud dashboard keys ---
HF_API_KEY_ID=
HF_API_KEY_SECRET=
# Endpoints from https://docs.higgsfield.ai — do not hard-code vendor paths blindly
HF_DEFAULT_IMAGE_ENDPOINT=
HF_DEFAULT_VIDEO_ENDPOINT=
HF_DEFAULT_VOICE_ENDPOINT=
