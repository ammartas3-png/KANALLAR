# Optional. Leave empty to write into ./data
KANALLAR_DATA=./data

# Studio bind address
KANALLAR_HOST=127.0.0.1
KANALLAR_PORT=8080

# Optional LLM rewrite (OpenAI-compatible). Pipeline works without this.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# YouTube Data API OAuth client (Desktop app JSON from Google Cloud Console)
YOUTUBE_CLIENT_SECRETS=./client_secret.json
YOUTUBE_TOKEN=./token.json
