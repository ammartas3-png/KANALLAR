# === CLOUD-FIRST YouTube Shorts factory (n8n orchestrates; worker renders) ===
RUN_MODE=cloud
KANALLAR_HOST=0.0.0.0
KANALLAR_PORT=8080
ACTIVE_CHANNEL=channel_01
PUBLIC_BASE_URL=

# Database — managed Postgres in production. SQLite only for CI smoke.
DATABASE_URL=postgresql+psycopg://kanallar:kanallar@db:5432/kanallar

# Renderer: ffmpeg (default — best cost/perf) or remotion (quality polish)
RENDERER=ffmpeg

# Worker schedule (UTC cron) — n8n may own cron in production
WORKER_PRODUCE_CRON=0 8 * * *
WORKER_ANALYTICS_HOURLY=true
WORKER_ENABLE_STUDIO=true

# Cost / safety gates
REQUIRE_HUMAN_APPROVAL=true
AUTO_PUBLISH=false
DRY_RUN=true
MAX_DAILY_VIDEOS=4
MAX_GENERATION_RETRIES=2
MAX_MEDIA_REGENERATIONS=2
TOPIC_SIMILARITY_COOLDOWN_DAYS=45

# LLM router (optional). Empty = local/heuristic.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OLLAMA_BASE_URL=http://127.0.0.1:11434
LLM_CHEAP_MODEL=gpt-4o-mini
LLM_NORMAL_MODEL=gpt-4o-mini
LLM_PREMIUM_MODEL=gpt-4o-mini

# TTS
VOICE_PROVIDER=auto
ELEVENLABS_API_KEY=
GOOGLE_TTS_API_KEY=

# YouTube — prefer JSON secrets on cloud (never commit these)
YOUTUBE_CLIENT_SECRETS=./client_secret.json
YOUTUBE_CLIENT_SECRETS_JSON=
# One token per brand channel (pick the Brand channel on the Google consent screen).
# The old single YOUTUBE_TOKEN_JSON belonged to the personal channel and is ignored.
YOUTUBE_TOKENS_DIR=./tokens
YOUTUBE_TOKEN_JSON__MONEY_IN_A_MINUTE=
YOUTUBE_TOKEN_JSON__SCIENCE_IN_A_MINUTE=
YOUTUBE_TOKEN_JSON__HISTORY_IN_A_MINUTE=
YOUTUBE_API_KEY=

PEXELS_API_KEY=

# MediaProvider — hybrid = local default, Kie only wow scenes
MEDIA_QUALITY=hybrid
KIE_WOW_ROLES_ONLY=true
MAX_KIE_SCENES_PER_VIDEO=1
KIE_API_KEY=
KIE_CALLBACK_URL=
KIE_DEFAULT_IMAGE_MODEL=
KIE_DEFAULT_VIDEO_MODEL=
KIE_DEFAULT_VOICE_MODEL=
HF_API_KEY_ID=
HF_API_KEY_SECRET=
HF_DEFAULT_IMAGE_ENDPOINT=
HF_DEFAULT_VIDEO_ENDPOINT=
HF_DEFAULT_VOICE_ENDPOINT=

# Telegram (prefer n8n credentials; optional on worker for verify)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=8715342169
APPROVAL_WEBHOOK_SECRET=

# Object storage — local (ephemeral) or s3 (R2/S3/MinIO)
STORAGE_BACKEND=local
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_ENDPOINT=
STORAGE_REGION=auto
STORAGE_PUBLIC_BASE_URL=

# n8n (Cursor secrets / n8n Variables — not committed)
# N8N_URL=https://ammartd20.app.n8n.cloud
# N8N_API_KEY=
# KANALLAR_BASE_URL=https://<worker>
