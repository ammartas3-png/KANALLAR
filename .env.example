# === CLOUD-FIRST (Mac local gerekmez) ===
RUN_MODE=cloud
KANALLAR_HOST=0.0.0.0
KANALLAR_PORT=8080
ACTIVE_CHANNEL=channel_01

# Database — managed Postgres in production. SQLite only for CI smoke.
DATABASE_URL=postgresql+psycopg://kanallar:kanallar@db:5432/kanallar

# Renderer: ffmpeg (default, $0) or remotion
RENDERER=ffmpeg

# Worker schedule (UTC cron)
WORKER_PRODUCE_CRON=0 8 * * *
WORKER_ANALYTICS_HOURLY=true
WORKER_ENABLE_STUDIO=true

# LLM router (all optional). Empty = local/heuristic, $0.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OLLAMA_BASE_URL=http://127.0.0.1:11434
LLM_CHEAP_MODEL=gpt-4o-mini
LLM_NORMAL_MODEL=gpt-4o-mini
LLM_PREMIUM_MODEL=gpt-4o-mini

# TTS
VOICE_PROVIDER=auto
ELEVENLABS_API_KEY=
GOOGLE_TTS_API_KEY=

# YouTube — prefer JSON secrets on cloud (no Mac file copy)
YOUTUBE_CLIENT_SECRETS=./client_secret.json
YOUTUBE_TOKEN=./token.json
YOUTUBE_CLIENT_SECRETS_JSON=
YOUTUBE_TOKEN_JSON=
YOUTUBE_API_KEY=

PEXELS_API_KEY=

# Human approval (default ON)
REQUIRE_HUMAN_APPROVAL=true

# MediaProvider
MEDIA_QUALITY=local
KIE_API_KEY=
KIE_CALLBACK_URL=
KIE_DEFAULT_IMAGE_MODEL=
KIE_DEFAULT_VIDEO_MODEL=
KIE_DEFAULT_VOICE_MODEL=
HF_API_KEY_ID=
HF_API_KEY_SECRET=
HF_DEFAULT_IMAGE_ENDPOINT=
HF_DEFAULT_VIDEO_ENDPOINT=
HF_DEFAULT_VOICE_ENDPOINT=

# Object storage — local (ephemeral) or s3 (R2/S3/MinIO)
STORAGE_BACKEND=local
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_ENDPOINT=
STORAGE_REGION=auto
STORAGE_PUBLIC_BASE_URL=
